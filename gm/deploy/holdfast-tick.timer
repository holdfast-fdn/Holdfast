# Tick cadence for Holdfast. Daily by default — "the world moves while you
# sleep". For a live session, switch OnCalendar to e.g. hourly (*-*-* *:00:00)
# or every 10 min (*:0/10), then: sudo systemctl restart holdfast-tick.timer
#
# Hourly costs ~24x the daily Hermes compute (the dominant variable cost), so
# keep it daily unless you're actively running a session.
#
# Install:
#   sudo cp gm/deploy/holdfast-tick.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now holdfast-tick.timer
#   systemctl list-timers holdfast-tick.timer

[Unit]
Description=Holdfast tick cadence

[Timer]
OnCalendar=*-*-* 12:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
