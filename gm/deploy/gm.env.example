# Holdfast GM service — environment template.
#
#   cp gm/deploy/gm.env.example ~/holdfast/gm.env
#   chmod 600 ~/holdfast/gm.env      # secrets — NEVER commit this file
#
# run-bot.sh sources this. [REQUIRED] vars throw on boot if missing; the rest
# show their default in (parens). Fill the <…> placeholders.

# ───────────────────────── chain ─────────────────────────
# [REQUIRED] Use a DEDICATED RPC (Alchemy/QuickNode/Ankr). The public
# sepolia.base.org rate-limits and caps eth_getLogs to 2000 blocks.
RPC_URL=https://base-sepolia.g.alchemy.com/v2/<your-key>

# [REQUIRED] deployed contracts (Base Sepolia values pre-filled — see docs/DEPLOYMENTS.md)
SETTLEMENT_ADDRESS=0x68C2Ef4544aA0071ebC98bD7bdAb958C11C3Af49
FLUX_ADDRESS=0xEf3c26E66c5B8b23EE26C70b78172D086a41d665

REGION_ID=0                       # (0) region to drive
FROM_BLOCK=0                      # (0) never read logs before this block

# ──────────────────── role keys (testnet, throwaway) ────────────────────
# Each role wallet needs Base Sepolia ETH for gas. Keep these OUT of git.
OPERATOR_PK=0x<operator-private-key>     # [REQUIRED] openTick / settleTick
PROVIDER_PK=0x<provider-private-key>     # [REQUIRED] fulfillWord (testnet EOA randomness)
OWNER_PK=0x<owner-private-key>           # genesis owner — enables POST /faucet (enroll)
TREASURY_PK=0x<treasury-private-key>     # burns metered compute Flux (needs a Flux balance)

# ───────────────────────── Telegram bot ─────────────────────────
TELEGRAM_BOT_TOKEN=<botfather-token>     # [REQUIRED] @holdfast_gmbot token
ANNOUNCE_CHAT_ID=<chat-or-channel-id>    # [REQUIRED] where the war report posts
ALERT_CHAT_ID=<operator-dm-id>           # uptime monitor alerts -> operator DM
                                         # (a positive user id; NOT the public channel)

# ───────────────────────── tick cadence ─────────────────────────
# Auto-tick interval in ms. 0 = disabled (drive ticks manually or via the
# systemd timer). 86400000 = daily. Hourly (3600000) costs ~24x Hermes compute.
TICK_INTERVAL_MS=0
# Manual/timer trigger: when this file appears, one tick fires and it's removed.
TICK_TRIGGER_FILE=/home/holdfast/holdfast/tick.trigger

# ───────────────────────── agent arena ─────────────────────────
AGENT_API_PORT=8799              # (0) public agent API port; 0/unset = closed
FAUCET_FLUX=200                  # (200) starting escrow granted per agent, once
                                 # (faucet served only when OWNER_PK is set)

# ───────────────────────── compute sink ─────────────────────────
COMPUTE_FLUX_PER_1K_TOKENS=0.5   # (0.5) GM-compute sink price; burned from the
                                 # treasury each tick (needs TREASURY_PK+FLUX_ADDRESS)

# ───────────────────────── AI factions ─────────────────────────
# "key:Display Name:archetype" comma-separated. Empty = no server factions.
# Archetypes: raider | turtle | … (see gm/src/faction.ts)
FACTIONS=ashen:Ashen Horde:raider

# ───────────────────────── Hermes (the GM brain) ─────────────────────────
# All optional — unset = deterministic stand-ins (rule parser / template
# narrator / heuristic factions). Set all three to enable the LLM.
HERMES_BASE_URL=https://inference-api.nousresearch.com/v1
HERMES_API_KEY=<nous-api-key>
HERMES_MODEL=<model-id>          # e.g. ~anthropic/claude-opus-latest (needs credits)
HERMES_TIMEOUT_MS=12000          # (12000)
HERMES_MAX_RETRIES=2             # (2)

# ───────────────────────── paths ─────────────────────────
KEYSTORE_PATH=/home/holdfast/holdfast/players.json   # [REQUIRED] custodial keys (chmod 600)
STATE_DIR=/home/holdfast/holdfast/state              # (./state) tick state + bundles
