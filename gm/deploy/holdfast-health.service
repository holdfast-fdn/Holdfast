# Holdfast GM liveness check — probes /health, restarts + alerts on outage.
# Install (adjust User= and the path if your layout differs):
#   sudo cp gm/deploy/holdfast-health.{service,timer} /etc/systemd/system/
#   cp gm/deploy/health-check.sh ~/holdfast/ && chmod +x ~/holdfast/health-check.sh
#   sudo systemctl daemon-reload && sudo systemctl enable --now holdfast-health.timer
[Unit]
Description=Holdfast GM liveness check (probe /health, alert+restart on outage)
After=holdfast-gm.service

[Service]
Type=oneshot
User=holdfast
ExecStart=/home/holdfast/holdfast/health-check.sh
